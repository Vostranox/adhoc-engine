#extension GL_ARB_separate_shader_objects : enable
#extension GL_GOOGLE_include_directive    : enable

#include "pbr_data.glsl"
#include "light_tiles.glsl"

layout(local_size_x = TILE_SIZE, local_size_y = TILE_SIZE) in;

layout(set = 0, binding = 0) uniform Camera {
	mat4 projView;
};

layout(std430, set = 3, binding = 0) writeonly buffer LightTiles {
	uint tiles[];
};

layout(set = 3, binding = 1) uniform sampler2D sceneDepth;

shared uint nearestDepth;
shared uint farthestDepth;

shared uint reaches[MAX_LIGHTS / 32u];

bool Reaches(vec3 center, float radius, vec4 planes[6]) {
	for (int i = 0; i < 6; ++i) {
		if (dot(planes[i].xyz, center) + planes[i].w < -radius) {
			return false;
		}
	}
	return true;
}

void main() {
	const uint invocations = TILE_SIZE * TILE_SIZE;
	uint invocation        = gl_LocalInvocationIndex;
	uvec2 extent           = uvec2(textureSize(sceneDepth, 0));

	if (invocation == 0u) {
		nearestDepth  = floatBitsToUint(1.0f);
		farthestDepth = floatBitsToUint(0.0f);
	}
	for (uint word = invocation; word < MAX_LIGHTS / 32u; word += invocations) {
		reaches[word] = 0u;
	}
	barrier();

	uvec2 pixel = gl_GlobalInvocationID.xy;
	if (all(lessThan(pixel, extent))) {
		float depth = texelFetch(sceneDepth, ivec2(pixel), 0).r;
		if (depth < 1.0f) {
			atomicMin(nearestDepth, floatBitsToUint(depth));
			atomicMax(farthestDepth, floatBitsToUint(depth));
		}
	}
	barrier();

	float nearest  = uintBitsToFloat(nearestDepth);
	float farthest = uintBitsToFloat(farthestDepth);
	if (nearest <= farthest) {
		vec2 boxMin    = vec2(gl_WorkGroupID.xy * TILE_SIZE) / vec2(extent) * 2.0f - 1.0f;
		vec2 boxMax    = vec2(min((gl_WorkGroupID.xy + 1u) * TILE_SIZE, extent)) / vec2(extent) * 2.0f - 1.0f;
		mat4 rows      = transpose(projView);
		vec4 planes[6] = vec4[](rows[0] - boxMin.x * rows[3], boxMax.x * rows[3] - rows[0], rows[1] - boxMin.y * rows[3], boxMax.y * rows[3] - rows[1], rows[2] - nearest * rows[3], farthest * rows[3] - rows[2]);
		for (int i = 0; i < 6; ++i) {
			planes[i] /= length(planes[i].xyz);
		}

		for (uint i = invocation; i < min(lightCount, MAX_LIGHTS); i += invocations) {
			if (Reaches(lights[i].position, lights[i].range, planes)) {
				atomicOr(reaches[i / 32u], 1u << (i % 32u));
			}
		}
	}
	barrier();

	if (invocation == 0u) {
		uint first = FirstOfTile(gl_WorkGroupID.xy, gl_NumWorkGroups.x);
		uint count = 0u;
		for (uint word = 0u; word < MAX_LIGHTS / 32u; ++word) {
			for (uint bits = reaches[word]; bits != 0u && count < TILE_STRIDE - 1u; bits &= bits - 1u) {
				++count;
				tiles[first + count] = word * 32u + uint(findLSB(bits));
			}
		}
		tiles[first] = count;
	}
}
